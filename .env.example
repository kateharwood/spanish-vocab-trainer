# Leave the key blank to use the local SQLite file (vocab.db) instead of Supabase.
SUPABASE_URL=

# Server-side only. Use the secret key (sb_secret_...) or the legacy service_role key.
# Never use the publishable/anon key here: it cannot write past row level security.
SUPABASE_SECRET_KEY=

# Only used when Supabase is not configured.
SQLITE_PATH=vocab.db

# Optional. Lets the app ask Claude for clearer definitions of new words while
# you study. Leave blank to turn that off.
ANTHROPIC_API_KEY=

# The password for the login page. Leave blank locally for no login; the site
# refuses to run on Vercel without one.
APP_PASSWORD=

# Your time zone, which decides when one day ends and the next begins.
# Needed on Vercel, whose servers run on UTC. Blank = the server's own zone.
APP_TIMEZONE=America/New_York
